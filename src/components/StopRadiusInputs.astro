---
import {
  MAX_STOP_RADIUS_METERS,
  MIN_STOP_RADIUS_METERS,
  STOP_RADIUS_STEP_METERS,
} from '../lib/settings';
import { STOP_TYPE_ENTRIES_CONFIG_ORDER } from '../lib/stop-type-config';

interface Props {
  showVisibilityControls?: boolean;
}

const { showVisibilityControls = false } = Astro.props;
---

<div class="radius-grid">
  {
    STOP_TYPE_ENTRIES_CONFIG_ORDER.map((entry) => (
      <div class:list={['radius-row', { 'radius-row--with-visibility': showVisibilityControls }]}>
        {showVisibilityControls ? (
          <button
            type="button"
            class="radius-row__visibility"
            data-stop-type-toggle={entry.type}
            aria-pressed="true"
            title={`${entry.label} ein- oder ausblenden`}
          >
            <span class="radius-row__dot" aria-hidden="true" style={`background:${entry.color}`} />
            <span class="radius-row__label">{entry.label}</span>
            <span class="visibility-switch" aria-hidden="true">
              <span />
            </span>
          </button>
        ) : (
          <span class="radius-row__meta">
            <span class="radius-row__dot" aria-hidden="true" style={`background:${entry.color}`} />
            <span class="radius-row__label">{entry.label}</span>
          </span>
        )}

        <label class="radius-row__control" for={entry.radiusInputId}>
          <span class="visually-hidden">Reichweite für {entry.label}</span>
          <input
            id={entry.radiusInputId}
            name={entry.radiusInputName}
            type="number"
            inputmode="numeric"
            enterkeyhint="done"
            min={MIN_STOP_RADIUS_METERS}
            max={MAX_STOP_RADIUS_METERS}
            step={STOP_RADIUS_STEP_METERS}
            required
          />
          <span class="radius-row__unit">m</span>
        </label>
      </div>
    ))
  }
</div>

<style>
  .radius-grid {
    display: grid;
    gap: 10px;
  }

  .radius-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid #d9e2ec;
    border-radius: 10px;
    background: #f8fafc;
    padding: 10px 12px;
  }

  .radius-row__meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .radius-row__visibility {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 4px 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: opacity 120ms ease;
  }

  .radius-row__visibility[aria-pressed='false'] .radius-row__dot,
  .radius-row__visibility[aria-pressed='false'] .radius-row__label {
    opacity: 0.46;
  }

  .visibility-switch {
    position: relative;
    width: 30px;
    height: 18px;
    flex: 0 0 30px;
    margin-left: 2px;
    border-radius: 999px;
    background: #1d7569;
    box-shadow: inset 0 0 0 1px rgba(15, 35, 31, 0.08);
    transition:
      background-color 120ms ease,
      box-shadow 120ms ease;
  }

  .visibility-switch span {
    position: absolute;
    top: 3px;
    left: 15px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 1px 3px rgba(15, 35, 31, 0.28);
    transition:
      left 120ms ease,
      background-color 120ms ease;
  }

  .radius-row__visibility[aria-pressed='false'] .visibility-switch {
    background: #d5dddb;
    box-shadow: inset 0 0 0 1px rgba(77, 96, 91, 0.08);
  }

  .radius-row__visibility[aria-pressed='false'] .visibility-switch span {
    left: 3px;
  }

  .radius-row__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex: 0 0 11px;
    box-shadow:
      0 0 0 2px white,
      0 0 0 3px rgba(32, 56, 51, 0.12);
  }

  .radius-row__label {
    color: #28413c;
    font-size: 13px;
    font-weight: 650;
    white-space: nowrap;
  }

  .radius-row__control {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .radius-row input {
    width: 104px;
    border: 1px solid #bcc8d7;
    border-radius: 8px;
    background: #fff;
    padding: 7px 8px;
    color: #243b53;
    font-size: 14px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .radius-row__unit {
    font-size: 13px;
    font-weight: 600;
    color: #52606d;
    min-width: 14px;
  }

  .radius-row input:focus-visible {
    outline: 2px solid #2d5f94;
    outline-offset: 1px;
  }

  .radius-row__visibility:focus-visible {
    border-radius: 5px;
    outline: 2px solid #1d7569;
    outline-offset: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  @media (max-width: 560px) {
    .radius-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .radius-row__control {
      flex: 0 0 auto;
    }

    .radius-row--with-visibility {
      align-items: center;
      flex-direction: row;
    }
  }
</style>
