---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main class="page-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    height: 100%;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }

  body {
    min-height: 100vh;
    min-height: 100dvh;
    background: #f5f7fa;
    color: #1f2933;
  }

  .page-content {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: auto;
  }
</style>
